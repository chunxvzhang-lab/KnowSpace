{
  "name": "knowspace",
  "private": true,
  "version": "2.7.5",
  "description": "KnowSpace - Personal Knowledge Workspace",
  "author": "KnowSpace Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "electron .",
    "desktop:pack": "npm run build && node scripts/package-desktop.cjs",
    "release": "node scripts/release.cjs",
    "desktop:pack:builder": "npm run build && electron-builder --win portable",
    "desktop:msi": "npm run build && electron-builder --win msi",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality:baseline": "node scripts/quality-ratchet.cjs",
    "test:baseline": "node scripts/capture-test-baseline.cjs",
    "test:baseline:check": "node scripts/capture-test-baseline.cjs --check --report test-baseline.json",
    "perf:baseline": "node scripts/capture-perf-baseline.cjs",
    "perf:baseline:check": "node scripts/capture-perf-baseline.cjs --check",
    "preflight": "node scripts/preflight.cjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,cjs,mjs,json,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.knowspace.app",
    "productName": "KnowSpace",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "icon.png",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "msi",
        "nsis"
      ]
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "KnowSpace",
      "artifactName": "KnowSpace-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KnowSpace",
      "uninstallDisplayName": "KnowSpace ${version}",
      "artifactName": "KnowSpace-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "dompurify": "^3.3.1",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.1.0",
    "markdown-it-front-matter": "^0.2.4",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.12.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.6.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
