# Dependencies
/node_modules

# Build and release outputs
/dist
/release/*
# electron-builder's alternate output, used when a file under release/ is held
# open by something that permits writes but not deletion — the normal pipeline
# cannot clear win-unpacked in that state. See scripts/refresh-release-in-place.cjs.
/release-next
!/release/KnowSpace-win-x64
/release/KnowSpace-win-x64/*
!/release/KnowSpace-win-x64/docs
!/release/KnowSpace-win-x64/docs/**
!/release/KnowSpace-win-x64/assets
!/release/KnowSpace-win-x64/assets/**
!/release/KnowSpace-win-x64/*.md


# Local agent and Gemini files
/.gemini
/.agents
/.agenteam
/.codex
/.playwright-cli
/.archify
__pycache__/
*.pyc
product_roadmap.md
ROADMAP.md

# Extracted into its own repository
# https://github.com/chunxvzhang-lab/Knowspace-web
/web/

# Unrelated deliverable material that happened to be authored inside the repo.
# Not KnowSpace documentation; kept out of git, out of grep, out of releases.
/docs/park_agent_solution/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Test baseline raw report (docs/TEST_BASELINE.md is the committed snapshot)
test-baseline.json
baseline-run.txt
baseline-capture.log

# Pre-split backup written by scripts/_archive/split-canvas-service.cjs
*.pre-split.ts.bak

# Local agent memory mirror, regenerated by the editor's memory tool on every
# write. A workstation artifact, not a KnowSpace document: no version, no owner,
# and otherwise it shows up as untracked noise in every `git status`.
PROJECT_MEMORY.md
